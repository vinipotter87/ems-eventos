# String de conexao Postgres (Neon via Vercel Storage preenche DATABASE_URL automaticamente)
DATABASE_URL=postgres://usuario:senha@host/banco?sslmode=require
# Segredo para assinar a sessao (string longa e aleatoria, 40+ caracteres)
AUTH_SECRET=troque-por-uma-string-longa-e-aleatoria
# Envio do codigo de acesso: Gmail com senha de aplicativo (Conta Google > Seguranca > Senhas de app)
GMAIL_USER=seu.email@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
# Emails (separados por virgula) que entram como Gerente Regional, mesmo fora de @ems.com.br
ADMIN_EMAILS=seu.email@gmail.com
# Somente para teste local: escreve o codigo no log em vez de enviar email
# OTP_DEV_LOG=1
